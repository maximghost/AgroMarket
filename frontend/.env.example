# Example environment file for frontend
# Copy this file to .env.local and update values as needed

VITE_API_URL=http://localhost:5000/api

# KKiaPay Configuration (Paiement)
# Mode: 'sandbox' ou 'live'
VITE_KKIAPAY_MODE=sandbox
VITE_KKIAPAY_PUBLIC_KEY=your_sandbox_public_key_here

# Vous pouvez obtenir les clés sur: https://app.kkiapay.com/
# 1. Créer un compte KKiaPay
# 2. Aller à Settings > API Keys
# 3. Copier les clés (sandbox d'abord pour les tests)
# 4. Remplacer les valeurs ci-dessus
