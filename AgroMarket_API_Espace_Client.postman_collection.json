{
  "info": {
    "_postman_id": "agromarket-collection-v1",
    "name": "AgroMarket API - Espace Client",
    "description": "Collection API complète pour tester l'espace client de AgroMarket",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 Authentification",
      "item": [
        {
          "name": "Register - Créer un compte",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('access_token', jsonData.data.access_token);",
                  "  pm.environment.set('user_id', jsonData.data.user._id);",
                  "  console.log('✅ Token sauvegardé');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Kouassi Ama\",\n  \"email\": \"ama@example.com\",\n  \"phone\": \"+229 90000000\",\n  \"password\": \"password123\",\n  \"role\": \"client\",\n  \"commune\": \"Cotonou\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login - Se connecter",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('access_token', jsonData.data.access_token);",
                  "  pm.environment.set('user_id', jsonData.data.user._id);",
                  "  console.log('✅ Connecté! Token mis en place');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ama@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "👤 Utilisateur (Profil)",
      "item": [
        {
          "name": "Get Me - Récupérer mon profil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/me",
              "host": ["{{base_url}}"],
              "path": ["users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "🛒 Produits / Catalogue",
      "item": [
        {
          "name": "Lister les produits (pagination + filtres)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var jsonData = pm.response.json();",
                  "  if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.environment.set('product_id', jsonData.data[0]._id);",
                  "    console.log('✅ Premier produit ID:', jsonData.data[0]._id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products?page=1&limit=10&commune=Cotonou&category=cereales&sort=price&order=asc",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "10",
                  "disabled": false
                },
                {
                  "key": "commune",
                  "value": "Cotonou",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "cereales",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "gari",
                  "disabled": true
                },
                {
                  "key": "sort",
                  "value": "price",
                  "disabled": true
                },
                {
                  "key": "order",
                  "value": "asc",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Détail produit + traçabilité",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}"]
            }
          }
        },
        {
          "name": "Fiche traçabilité d'un produit",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}/traceability",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}", "traceability"]
            }
          }
        }
      ]
    },
    {
      "name": "🛍️ Panier (Cart)",
      "item": [
        {
          "name": "Récupérer mon panier",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cart",
              "host": ["{{base_url}}"],
              "path": ["cart"]
            }
          }
        },
        {
          "name": "Ajouter un article au panier",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  console.log('✅ Article ajouté au panier');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"{{product_id}}\",\n  \"qty\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/cart/items",
              "host": ["{{base_url}}"],
              "path": ["cart", "items"]
            }
          }
        },
        {
          "name": "Modifier la quantité d'un article",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qty\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/cart/items/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["cart", "items", "{{product_id}}"]
            }
          }
        },
        {
          "name": "Supprimer un article du panier",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cart/items/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["cart", "items", "{{product_id}}"]
            }
          }
        },
        {
          "name": "Vider complètement le panier",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cart",
              "host": ["{{base_url}}"],
              "path": ["cart"]
            }
          }
        }
      ]
    },
    {
      "name": "📦 Commandes (Orders)",
      "item": [
        {
          "name": "Lister mes commandes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/orders?page=1&limit=10&status=pending",
              "host": ["{{base_url}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "pending",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Passer une commande (depuis le panier)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('order_id', jsonData.data._id);",
                  "  console.log('✅ Commande créée! ID:', jsonData.data._id);",
                  "  console.log('Total: ' + jsonData.data.total_amount + ' FCFA');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delivery_address\": {\n    \"full_name\": \"Kouassi Ama\",\n    \"phone\": \"+229 90000000\",\n    \"commune\": \"Cotonou\",\n    \"quartier\": \"Zogbo\",\n    \"indications\": \"Prés de la mosquée\"\n  },\n  \"delivery_type\": \"standard\",\n  \"payment_method\": \"cash_on_delivery\",\n  \"notes\": \"Livrer entre 14h et 16h SVP\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Détail d'une commande",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}"]
            }
          }
        },
        {
          "name": "Annuler une commande (pending uniquement)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}", "cancel"]
            }
          }
        }
      ]
    },
